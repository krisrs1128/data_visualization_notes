@ARTICLE{Wang2021-rz,
  title     = "Network modeling in biology: Statistical methods for gene and
               brain networks",
  author    = "Wang, Y X Rachel and Li, Lexin and Li, Jingyi Jessica and Huang,
               Haiyan",
  abstract  = "The rise of network data in many different domains has offered
               researchers new insight into the problem of modeling complex
               systems and propelled the development of numerous innovative
               statistical methodologies and computational tools. In this
               paper, we primarily focus on two types of biological networks,
               gene networks and brain networks, where statistical network
               modeling has found both fruitful and challenging applications.
               Unlike other network examples such as social networks where
               network edges can be directly observed, both gene and brain
               networks require careful estimation of edges using covariates as
               a first step. We provide a discussion on existing statistical
               and computational methods for edge esitimation and subsequent
               statistical inference problems in these two types of biological
               networks.",
  journal   = "Stat. Sci.",
  publisher = "Institute of Mathematical Statistics",
  volume    =  36,
  number    =  1,
  pages     = "89--108",
  month     =  feb,
  year      =  2021,
  keywords  = "brain connectivity networks; gene regulatory networks; network
               inference; network reconstruction",
  language  = "en"
}

